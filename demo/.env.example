# Variables for the Orchard Core demo container (set them as Railway service variables).
# Never commit real values.

# Demo accounts. DEMO_ADMIN_* is required on first boot (AutoSetup); both are created on
# every start if missing. Orchard Core's password rules: 6+ characters with upper- and
# lower-case letters, a digit and a symbol. Sign in with the e-mail address.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_EDITOR_EMAIL=
DEMO_EDITOR_PASSWORD=
# Fallback names for DEMO_ADMIN_* (used only when DEMO_ADMIN_EMAIL is empty):
# ORCHARD_ADMIN_EMAIL=
# ORCHARD_ADMIN_PASSWORD=

# Supertext. Account: https://www.supertext.com/person/en/account/signin
# API key: https://www.supertext.com/en/integrations/api (requires the Admin role)
SUPERTEXT_API_KEY=
# SUPERTEXT_API_ENDPOINT=https://api.supertext.com/v1/
# Optional: another review service for cultures with "Translation review" ticked
# (default: Supertext's review service; empty turns review off)
# SUPERTEXT_REVIEW_URL=http://localhost:3000/v1/
# Send version information to Supertext (site URL and versions; no content, no key): on by default
# SUPERTEXT_VERSION_REPORTS=0
# Tests and screenshots only: send version reports to a stand-in instead of the Supertext Commando Center
# SUPERTEXT_REPORT_URL=http://127.0.0.1:8765/report

# Railway: port Kestrel listens on (match the domain's target port) and the Dockerfile
PORT=8080
RAILWAY_DOCKERFILE_PATH=demo/Dockerfile
