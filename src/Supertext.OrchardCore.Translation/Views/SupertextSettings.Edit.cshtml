@model SupertextSettingsViewModel
@inject Supertext.OrchardCore.Translation.Services.KeyCheckMessages KeyCheckMessages
@{
    var keyPlaceholder = Model.HasStoredApiKey ? T["A key is stored. Leave empty to keep it."].Value : T["Paste your Supertext API key"].Value;
    var keyHint = T["It may include the Supertext-Auth-Key prefix. The key is stored encrypted and checked when you save."];
    var signupUrl = "https://www.supertext.com/person/en/account/signin";
    var apiKeyUrl = "https://www.supertext.com/en/integrations/api";
    var politenessFormal = T["Formal (e.g. German Sie)"];
    var politenessInformal = T["Informal (e.g. German du)"];
    var autoHint = T["When an editor creates a culture version from the Localizations menu, the copy is translated with Supertext before the editor opens it. Translate with Supertext works either way."];
}

<h3>@T["Connection"]</h3>

<div class="mb-3">
    <label asp-for="ApiKey" class="form-label">@T["API key"]</label>
    @if (Model.ApiKeyFromEnvironment)
    {
        <div class="alert alert-info mb-0">@T["The API key comes from the SUPERTEXT_API_KEY environment variable (or the Supertext:ApiKey configuration) and overrides the one stored here."]</div>
    }
    else
    {
        <input asp-for="ApiKey" type="password" autocomplete="new-password" class="form-control" placeholder="@keyPlaceholder" />
        <span class="hint">@keyHint</span>
        <span class="hint d-block supertext-key-help">@T["No Supertext account yet? <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">Create one at supertext.com</a>. Generate your API key at <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (requires the Admin role).", signupUrl, apiKeyUrl]</span>
        @if (Model.HasStoredApiKey)
        {
            <div class="form-check mt-2">
                <input asp-for="RemoveApiKey" type="checkbox" class="form-check-input" />
                <label asp-for="RemoveApiKey" class="form-check-label">@T["Remove the stored API key"]</label>
            </div>
        }
    }
</div>

<div class="mb-3">
    <label asp-for="Endpoint" class="form-label">@T["API endpoint"]</label>
    <input asp-for="Endpoint" class="form-control" placeholder="https://api.supertext.com/v1/" disabled="@Model.EndpointFromEnvironment" />
    <span asp-validation-for="Endpoint"></span>
    <span class="hint">@T["Leave empty to use {0}.", "https://api.supertext.com/v1/"]</span>
    @if (Model.EndpointFromEnvironment)
    {
        <span class="hint d-block supertext-endpoint-env">@T["Set by SUPERTEXT_API_ENDPOINT: {0}", Model.EndpointInEffect]</span>
    }
</div>

<div class="mb-3 supertext-key-check">
    <span class="form-label d-block">@T["API key check"]</span>
    @if (Model.KeyCheck is null)
    {
        <span class="text-muted">@T["Not checked yet. The key is checked when you save these settings."]</span>
    }
    else
    {
        var checkClass = Model.KeyCheck.Status == "ok" ? "alert-success" : Model.KeyCheck.Status == "invalid" ? "alert-danger" : "alert-warning";
        <div class="alert @checkClass mb-0 py-2">
            @KeyCheckMessages.Describe(Model.KeyCheck)
            <span class="d-block small text-muted">@(await KeyCheckMessages.CheckedAtAsync(Model.KeyCheck))</span>
        </div>
    }
</div>

<h3>@T["Translation"]</h3>

<div class="mb-3">
    <div class="form-check">
        <input asp-for="TranslateNewLocalizations" type="checkbox" class="form-check-input" />
        <label asp-for="TranslateNewLocalizations" class="form-check-label">@T["Translate new localizations automatically"]</label>
    </div>
    <span class="hint">@autoHint</span>
</div>

<div class="mb-3">
    <label asp-for="Politeness" class="form-label">@T["Form of address"]</label>
    <select asp-for="Politeness" class="form-select">
        <option value="default">@T["As in the source"]</option>
        <option value="more">@politenessFormal</option>
        <option value="less">@politenessInformal</option>
    </select>
</div>

<div class="mb-3 supertext-language-mapping">
    <span class="form-label d-block">@T["Language mapping"]</span>
    <span class="hint d-block mb-2">@T["The Supertext language each culture is translated into (and from). Cultures whose name is a Supertext code (de-CH, fr-CH, es …) are pre-selected; others, such as de or en, need a choice, because Supertext needs to know the region."]</span>
    @if (Model.Mappings.Any(m => string.IsNullOrEmpty(m.Code)))
    {
        <div class="alert alert-warning py-2 supertext-unmapped">@T["Some cultures have no Supertext language yet. Content can't be translated into or from them until you choose one."]</div>
    }
    <table class="table table-sm align-middle mb-0">
        <thead>
            <tr>
                <th>@T["Culture"]</th>
                <th>@T["Supertext language"]</th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Model.Mappings.Count; i++)
            {
                var row = Model.Mappings[i];
                var known = Model.TargetLanguages.Any(l => l.Code == row.Code);
                <tr>
                    <td>
                        <input type="hidden" asp-for="Mappings[i].Culture" />
                        <label asp-for="Mappings[i].Code">@row.CultureName <span class="text-muted">(@row.Culture)</span></label>
                    </td>
                    <td>
                        <select asp-for="Mappings[i].Code" class="form-select form-select-sm">
                            <option value="">@T["Not mapped"]</option>
                            @if (!string.IsNullOrEmpty(row.Code) && !known)
                            {
                                <option value="@row.Code" selected>@row.Code</option>
                            }
                            @foreach (var language in Model.TargetLanguages)
                            {
                                <option value="@language.Code" selected="@(language.Code == row.Code)">@language.Name (@language.Code)</option>
                            }
                        </select>
                        @if (string.IsNullOrEmpty(row.Code))
                        {
                            <span class="d-block small text-danger">@T["Not mapped: this culture can't be translated with Supertext yet."]</span>
                        }
                        @if (row.UnknownCode)
                        {
                            <span class="d-block small text-danger">@T["Supertext doesn't offer the code {0}. Choose a language from the list.", row.Code]</span>
                        }
                        @if (row.PolitenessUnavailable)
                        {
                            <span class="d-block small text-warning-emphasis">@T["Supertext offers no formal/informal choice for this language: it is translated in the default tone."]</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mb-3">
    <label asp-for="ExcludedFields" class="form-label">@T["Fields not to translate"]</label>
    <textarea asp-for="ExcludedFields" rows="3" class="form-control font-monospace" placeholder="Article.Subtitle"></textarea>
    <span class="hint">@T["One per line: Part.Field (e.g. Article.Subtitle), a part (e.g. HtmlBodyPart) or ContentType.Part.Field. Excluded fields keep the source text."]</span>
</div>

<div class="mb-3">
    <label asp-for="PollTimeoutSeconds" class="form-label">@T["Timeout per language (seconds)"]</label>
    <input asp-for="PollTimeoutSeconds" type="number" min="30" max="3600" class="form-control" style="max-width: 10rem" />
    <span asp-validation-for="PollTimeoutSeconds"></span>
</div>

<h3>@T["Support"]</h3>

<div class="mb-3 supertext-version-reports">
    <div class="form-check">
        @if (Model.VersionReportsFromEnvironment is bool forced)
        {
            <input type="checkbox" class="form-check-input" id="SendVersionInformationForced" checked="@forced" disabled />
            <label class="form-check-label" for="SendVersionInformationForced">@T["Send version information to Supertext"]</label>
        }
        else
        {
            <input asp-for="SendVersionInformation" type="checkbox" class="form-check-input" />
            <label asp-for="SendVersionInformation" class="form-check-label">@T["Send version information to Supertext"]</label>
        }
    </div>
    <span class="hint">@T["Sends the site URL and the versions of this plugin, the CMS and the runtime to Supertext when you save these settings and after an update, so Supertext support can see which version you run. No content, no API key and no personal data are sent."]</span>
    @if (Model.VersionReportsFromEnvironment is bool forcedValue)
    {
        <span class="hint d-block">@(forcedValue ? T["Turned on by SUPERTEXT_VERSION_REPORTS."] : T["Turned off by SUPERTEXT_VERSION_REPORTS."])</span>
    }
</div>

@if (!string.IsNullOrEmpty(Model.ModuleVersion))
{
    <p class="text-muted small supertext-module-version">
        @if (Model.ModuleReleaseUrl != null)
        {
            @T["Module version: <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">{1}</a>", Model.ModuleReleaseUrl, Model.ModuleVersion]
        }
        else
        {
            @T["Module version: {0}", Model.ModuleVersion]
        }
    </p>
}
