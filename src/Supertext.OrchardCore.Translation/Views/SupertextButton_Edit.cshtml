@model ContentItemViewModel
@{
    var returnUrl = Context.Request.Query["returnUrl"].ToString();
}
<a asp-route="Supertext.Translate" asp-route-contentItemId="@Model.ContentItem.ContentItemId" asp-route-returnUrl="@(string.IsNullOrEmpty(returnUrl) ? FullRequestPath : returnUrl)" class="btn btn-outline-primary supertext-translate mb-1" title="@T["Translates the saved version. Save your changes first."]"><i class="fa-solid fa-language" aria-hidden="true"></i> @T["Translate with Supertext"]</a>
