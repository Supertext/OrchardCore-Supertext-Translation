<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <!-- The bundled SDK and Plugin Health use nullable annotations; this module doesn't enable nullable checks. -->
    <NoWarn>$(NoWarn);CS8632</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <Version>0.1.0</Version>
    <PackageId>Supertext.OrchardCore.Translation</PackageId>
    <Title>Supertext Translation for Orchard Core</Title>
    <Authors>Supertext AG</Authors>
    <Description>Translate Orchard Core content items into other cultures with Supertext AI translation.</Description>
    <PackageTags>OrchardCore;OrchardCoreCMS;Module;translation;localization;Supertext</PackageTags>
    <PackageProjectUrl>https://github.com/Supertext/OrchardCore-Supertext-Translation</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Module.Targets" Version="3.0.1" />
    <PackageReference Include="OrchardCore.Admin.Abstractions" Version="3.0.1" />
    <PackageReference Include="OrchardCore.ContentLocalization.Abstractions" Version="3.0.1" />
    <PackageReference Include="OrchardCore.ContentManagement" Version="3.0.1" />
    <PackageReference Include="OrchardCore.ContentManagement.Display" Version="3.0.1" />
    <PackageReference Include="OrchardCore.Contents.Core" Version="3.0.1" />
    <PackageReference Include="OrchardCore.ContentTypes.Abstractions" Version="3.0.1" />
    <PackageReference Include="OrchardCore.DisplayManagement" Version="3.0.1" />
    <PackageReference Include="OrchardCore.Localization.Abstractions" Version="3.0.1" />
    <PackageReference Include="OrchardCore.Navigation.Core" Version="3.0.1" />
    <PackageReference Include="OrchardCore.Settings.Core" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Supertext SDK, bundled (namespace Supertext.OrchardCore.Translation.Sdk and .Sdk.V1): see lib/supertext-sdk/README.md -->
    <Compile Include="../../lib/supertext-sdk/src/**/*.cs" Link="Sdk/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Supertext Plugin Health, bundled (namespace Supertext.OrchardCore.Translation.PluginHealth): see lib/supertext-plugin-health/README.md -->
    <Compile Include="../../lib/supertext-plugin-health/src/**/*.cs" Link="PluginHealth/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
