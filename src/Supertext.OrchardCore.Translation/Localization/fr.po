msgid "API key"
msgstr "Clé API"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "The API key comes from the SUPERTEXT_API_KEY environment variable (or the Supertext:ApiKey configuration) and overrides the one stored here."
msgstr "La clé API provient de la variable d’environnement SUPERTEXT_API_KEY (ou de la configuration Supertext:ApiKey) et remplace celle enregistrée ici."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "No Supertext account yet? <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">Create one at supertext.com</a>. Generate your API key at <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (requires the Admin role)."
msgstr "Pas encore de compte Supertext ? <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">Créez-en un sur supertext.com</a>. Générez votre clé API sur <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (rôle Admin requis)."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Remove the stored API key"
msgstr "Supprimer la clé API enregistrée"

