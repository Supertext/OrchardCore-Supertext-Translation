msgid "Set by SUPERTEXT_API_ENDPOINT: {0}"
msgstr "Défini par SUPERTEXT_API_ENDPOINT : {0}"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Translation"
msgstr "Traduction"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Translate new localizations automatically"
msgstr "Traduire automatiquement les nouvelles localisations"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Form of address"
msgstr "Forme d’adresse"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "As in the source"
msgstr "Comme dans la source"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Language codes"
msgstr "Codes de langue"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "One culture=code per line, if Supertext should get a different language code than the culture's name. Cultures of this site: {0}."
msgstr "Une ligne culture=code par culture, si Supertext doit recevoir un autre code de langue que le nom de la culture. Cultures de ce site : {0}."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Fields not to translate"
msgstr "Champs à ne pas traduire"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "One per line: Part.Field (e.g. Article.Subtitle), a part (e.g. HtmlBodyPart) or ContentType.Part.Field. Excluded fields keep the source text."
msgstr "Un par ligne : Part.Field (p. ex. Article.Subtitle), une partie (p. ex. HtmlBodyPart) ou ContentType.Part.Field. Les champs exclus gardent le texte source."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Timeout per language (seconds)"
msgstr "Délai par langue (secondes)"

