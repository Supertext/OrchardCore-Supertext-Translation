#: AdminMenu.cs
msgctxt "Supertext.OrchardCore.Translation.AdminMenu"
msgid "Configuration"
msgstr "Configuration"

#: AdminMenu.cs
msgctxt "Supertext.OrchardCore.Translation.AdminMenu"
