msgid "Translation"
msgstr "Traduction"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Translate new localizations automatically"
msgstr "Traduire automatiquement les nouvelles localisations"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Form of address"
msgstr "Forme d’adresse"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "As in the source"
msgstr "Comme dans la source"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Fields not to translate"
msgstr "Champs à ne pas traduire"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "One per line: Part.Field (e.g. Article.Subtitle), a part (e.g. HtmlBodyPart) or ContentType.Part.Field. Excluded fields keep the source text."
msgstr "Un par ligne : Part.Field (p. ex. Article.Subtitle), une partie (p. ex. HtmlBodyPart) ou ContentType.Part.Field. Les champs exclus gardent le texte source."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Timeout per language (seconds)"
msgstr "Délai par langue (secondes)"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Module version: <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">{1}</a>"
msgstr "Version du module : <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">{1}</a>"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Module version: {0}"
msgstr "Version du module : {0}"

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "Supertext does not support this language pair ({0} → {1}). Check the language mapping under Settings → Supertext."
msgstr "Supertext ne prend pas en charge cette paire de langues ({0} → {1}). Vérifiez l’association des langues sous Paramètres → Supertext."

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "The language {0} has no Supertext language yet. Ask your administrator to map it under Settings → Supertext → Language mapping."
msgstr "La langue {0} n’est encore associée à aucune langue Supertext. Demandez à votre administrateur de l’associer sous Paramètres → Supertext → Association des langues."

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "Supertext offers no formal or informal tone for this language. Ask your administrator to set the form of address under Settings → Supertext to As in the source."
msgstr "Supertext ne propose pas de ton formel ou informel pour cette langue. Demandez à votre administrateur de régler la forme d’adresse sous Paramètres → Supertext sur « Comme dans la source »."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "API key check"
msgstr "Vérification de la clé API"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Not checked yet. The key is checked when you save these settings."
msgstr "Pas encore vérifiée. La clé est vérifiée lorsque vous enregistrez ces paramètres."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Language mapping"
msgstr "Association des langues"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "The Supertext language each culture is translated into (and from). Each culture is pre-selected with its Supertext code (de-CH, es …) or the usual default (de → de-DE, en → en-US, fr → fr-FR, it → it-IT, pt → pt-PT, zh → zh-Hans); pick another one to change it. Cultures without an obvious Supertext language (en-IE, de-LI …) need a choice."
msgstr "La langue Supertext vers laquelle (et depuis laquelle) chaque culture est traduite. Chaque culture est présélectionnée avec son code Supertext (de-CH, es …) ou la valeur par défaut habituelle (de → de-DE, en → en-US, fr → fr-FR, it → it-IT, pt → pt-PT, zh → zh-Hans) ; choisissez-en une autre pour la modifier. Les cultures sans langue Supertext évidente (en-IE, de-LI …) nécessitent un choix."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Some cultures have no Supertext language yet. Content can't be translated into or from them until you choose one."
msgstr "Certaines cultures ne sont encore associées à aucune langue Supertext. Le contenu ne peut être traduit vers elles ou depuis elles que lorsque vous en avez choisi une."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Culture"
msgstr "Culture"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Supertext language"
msgstr "Langue Supertext"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "— choose —"
msgstr "— choisir —"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Not mapped: this culture can't be translated with Supertext yet."
msgstr "Non associée : cette culture ne peut pas encore être traduite avec Supertext."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Supertext doesn't offer the code {0}. Choose a language from the list."
msgstr "Supertext ne propose pas le code {0}. Choisissez une langue dans la liste."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Supertext offers no formal/informal choice for this language: it is translated in the default tone."
msgstr "Supertext ne propose pas de choix formel/informel pour cette langue : elle est traduite avec le ton par défaut."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Support"
msgstr "Assistance"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Send version information to Supertext"
msgstr "Envoyer les informations de version à Supertext"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Sends the site URL and the versions of this plugin, the CMS and the runtime to Supertext when you save these settings and after an update, so Supertext support can see which version you run. No content, no API key and no personal data are sent."
msgstr "Envoie à Supertext l'URL du site ainsi que les versions de ce plugin, du CMS et de l'environnement d'exécution lorsque vous enregistrez ces paramètres et après une mise à jour. Le support Supertext voit ainsi quelle version vous utilisez. Aucun contenu, aucune clé API et aucune donnée personnelle ne sont transmis."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Turned on by SUPERTEXT_VERSION_REPORTS."
msgstr "Activé par SUPERTEXT_VERSION_REPORTS."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Turned off by SUPERTEXT_VERSION_REPORTS."
msgstr "Désactivé par SUPERTEXT_VERSION_REPORTS."

#: Services/KeyCheckMessages.cs
msgctxt "Supertext.OrchardCore.Translation.Services.KeyCheckMessages"
msgid "API key checked: the connection to Supertext works."
msgstr "Clé API vérifiée : la connexion à Supertext fonctionne."

#: Services/KeyCheckMessages.cs
msgctxt "Supertext.OrchardCore.Translation.Services.KeyCheckMessages"
msgid "Supertext rejected the API key. Check that you copied the whole key, or generate a new one at <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (requires the Admin role). No Supertext account yet? Create one at <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">supertext.com</a>."
msgstr "Supertext a refusé la clé API. Vérifiez que vous avez copié la clé entière ou générez-en une nouvelle sur <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (rôle Admin requis). Pas encore de compte Supertext ? Créez-en un sur <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">supertext.com</a>."

#: Services/KeyCheckMessages.cs
msgctxt "Supertext.OrchardCore.Translation.Services.KeyCheckMessages"
msgid "No API key is set yet. No Supertext account yet? Create one at <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">supertext.com</a>. Generate your API key at <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (requires the Admin role)."
msgstr "Aucune clé API n'est encore saisie. Pas encore de compte Supertext ? Créez-en un sur <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">supertext.com</a>. Générez votre clé API sur <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (rôle Admin requis)."

#: Services/KeyCheckMessages.cs
msgctxt "Supertext.OrchardCore.Translation.Services.KeyCheckMessages"
msgid "The API key couldn't be checked because Supertext can't be reached. The settings are saved; check again later."
msgstr "La clé API n'a pas pu être vérifiée, car Supertext n'est pas joignable. Les paramètres sont enregistrés ; réessayez plus tard."

#: Services/KeyCheckMessages.cs
msgctxt "Supertext.OrchardCore.Translation.Services.KeyCheckMessages"
msgid "The API key couldn't be checked: Supertext answered with an error ({0}). The settings are saved; check again later."
msgstr "La clé API n'a pas pu être vérifiée : Supertext a répondu par une erreur ({0}). Les paramètres sont enregistrés ; réessayez plus tard."

#: Services/KeyCheckMessages.cs
msgctxt "Supertext.OrchardCore.Translation.Services.KeyCheckMessages"
msgid "checked {0}"
msgstr "vérifiée {0}"

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "An HTML file holds one language: choose exactly one."
msgstr "Un fichier HTML contient une seule langue : choisissez-en exactement une."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "Nothing to translate."
msgstr "Rien à traduire."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "Choose a file to import."
msgstr "Choisissez un fichier à importer."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "You may not translate this content item with Supertext."
msgstr "Vous n’êtes pas autorisé à traduire cet élément avec Supertext."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "This language already has a translation. Tick “Yes, overwrite the existing translations” and import the file again."
msgstr "Cette langue a déjà une traduction. Cochez « Oui, écraser les traductions existantes » et importez à nouveau le fichier."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "This file wasn't exported by the Supertext module, or its header was removed."
msgstr "Ce fichier n’a pas été exporté par le module Supertext, ou son en-tête a été supprimé."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "The file is too large (at most 10 MB)."
msgstr "Le fichier est trop volumineux (10 Mo au maximum)."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "This file isn't a valid XLIFF or HTML translation file."
msgstr "Ce fichier n’est pas un fichier de traduction XLIFF ou HTML valide."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "This file belongs to another system ({0})."
msgstr "Ce fichier appartient à un autre système ({0})."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "The site has no language {0}."
msgstr "Le site n’a pas de langue {0}."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "The content item this file was exported from no longer exists."
msgstr "L’élément à partir duquel ce fichier a été exporté n’existe plus."

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Export for translation"
msgstr "Exporter pour traduction"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Download the texts of this item as a file for a translator or a translation tool, or upload it to Supertext's web app. Import the translated file below."
msgstr "Téléchargez les textes de cet élément dans un fichier pour un traducteur ou un outil de traduction, ou chargez-le dans l’application web de Supertext. Importez ensuite le fichier traduit ci-dessous."

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "File format"
msgstr "Format de fichier"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "XLIFF 1.2 (for translation tools)"
msgstr "XLIFF 1.2 (pour les outils de traduction)"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "HTML (one language per file)"
msgstr "HTML (une langue par fichier)"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Target languages"
msgstr "Langues cibles"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Download file"
msgstr "Télécharger le fichier"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Import translation"
msgstr "Importer une traduction"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Imported texts are saved as drafts of the localizations, like translations with Supertext. Review and publish them when they're ready."
msgstr "Les textes importés sont enregistrés comme brouillons des localisations, comme les traductions avec Supertext. Vérifiez-les et publiez-les lorsqu’ils sont prêts."

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Translated file (XLIFF or HTML)"
msgstr "Fichier traduit (XLIFF ou HTML)"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Also import texts whose source changed since the export"
msgstr "Importer aussi les textes dont la source a changé depuis l’export"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Imported: {0}"
msgstr "Importés : {0}"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Skipped, source changed since the export: {0}"
msgstr "Ignorés, source modifiée depuis l’export : {0}"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Not translated in the file: {0}"
msgstr "Non traduits dans le fichier : {0}"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Formatting changed, not imported: {0}"
msgstr "Mise en forme modifiée, non importés : {0}"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Not in the file: {0}"
msgstr "Absents du fichier : {0}"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Saved as a draft. Open it to review."
msgstr "Enregistré comme brouillon. Ouvrez-le pour le vérifier."

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Nothing was imported."
msgstr "Rien n’a été importé."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Suggested by Supertext."
msgstr "Proposé par Supertext."

