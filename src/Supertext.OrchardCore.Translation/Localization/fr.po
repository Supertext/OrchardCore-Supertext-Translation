#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "A key is stored. Leave empty to keep it."
msgstr "Une clé est enregistrée. Laissez vide pour la conserver."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Paste your Supertext API key"
msgstr "Collez votre clé API Supertext"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "It may include the Supertext-Auth-Key prefix. The key is stored encrypted and checked when you save."
msgstr "Elle peut inclure le préfixe Supertext-Auth-Key. La clé est enregistrée chiffrée et vérifiée lors de l’enregistrement."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Formal (e.g. German Sie)"
msgstr "Formel (p. ex. vouvoiement)"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Informal (e.g. German du)"
msgstr "Informel (p. ex. tutoiement)"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "When an editor creates a culture version from the Localizations menu, the copy is translated with Supertext before the editor opens it. Translate with Supertext works either way."
msgstr "Lorsqu’un rédacteur crée une version dans une autre culture depuis le menu Localisations, la copie est traduite avec Supertext avant qu’il ne l’ouvre. « Traduire avec Supertext » fonctionne dans les deux cas."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Connection"
msgstr "Connexion"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "API key"
msgstr "Clé API"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "The API key comes from the SUPERTEXT_API_KEY environment variable (or the Supertext:ApiKey configuration) and overrides the one stored here."
msgstr "La clé API provient de la variable d’environnement SUPERTEXT_API_KEY (ou de la configuration Supertext:ApiKey) et remplace celle enregistrée ici."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "No Supertext account yet? <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">Create one at supertext.com</a>. Generate your API key at <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (requires the Admin role)."
msgstr "Pas encore de compte Supertext ? <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">Créez-en un sur supertext.com</a>. Générez votre clé API sur <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (rôle Admin requis)."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Remove the stored API key"
msgstr "Supprimer la clé API enregistrée"

