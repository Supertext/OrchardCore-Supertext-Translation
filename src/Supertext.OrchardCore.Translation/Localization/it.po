#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "A key is stored. Leave empty to keep it."
msgstr "Una chiave è salvata. Lasci vuoto per mantenerla."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Paste your Supertext API key"
msgstr "Incolli la Sua chiave API Supertext"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "It may include the Supertext-Auth-Key prefix. The key is stored encrypted and checked when you save."
msgstr "Può includere il prefisso Supertext-Auth-Key. La chiave viene salvata in forma crittografata e verificata al salvataggio."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Formal (e.g. German Sie)"
msgstr "Formale (ad es. Lei)"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Informal (e.g. German du)"
msgstr "Informale (ad es. tu)"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "When an editor creates a culture version from the Localizations menu, the copy is translated with Supertext before the editor opens it. Translate with Supertext works either way."
msgstr "Quando un redattore crea una versione in un’altra lingua dal menu Localizzazioni, la copia viene tradotta con Supertext prima che la apra. «Traduci con Supertext» funziona in entrambi i casi."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Connection"
msgstr "Connessione"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "API key"
msgstr "Chiave API"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "The API key comes from the SUPERTEXT_API_KEY environment variable (or the Supertext:ApiKey configuration) and overrides the one stored here."
msgstr "La chiave API proviene dalla variabile d’ambiente SUPERTEXT_API_KEY (o dalla configurazione Supertext:ApiKey) e ha la precedenza su quella salvata qui."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "No Supertext account yet? <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">Create one at supertext.com</a>. Generate your API key at <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (requires the Admin role)."
msgstr "Non ha ancora un account Supertext? <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">Ne crei uno su supertext.com</a>. Generi la Sua chiave API su <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (richiede il ruolo Admin)."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Remove the stored API key"
msgstr "Rimuovi la chiave API salvata"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "API endpoint"
msgstr "Endpoint API"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Leave empty to use {0}."
msgstr "Lasci vuoto per usare {0}."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Set by SUPERTEXT_API_ENDPOINT: {0}"
msgstr "Impostato da SUPERTEXT_API_ENDPOINT: {0}"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Translation"
msgstr "Traduzione"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Translate new localizations automatically"
msgstr "Traduci automaticamente le nuove localizzazioni"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Form of address"
msgstr "Forma di cortesia"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "As in the source"
msgstr "Come nell’originale"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Fields not to translate"
msgstr "Campi da non tradurre"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "One per line: Part.Field (e.g. Article.Subtitle), a part (e.g. HtmlBodyPart) or ContentType.Part.Field. Excluded fields keep the source text."
msgstr "Uno per riga: Part.Field (ad es. Article.Subtitle), una parte (ad es. HtmlBodyPart) o ContentType.Part.Field. I campi esclusi mantengono il testo originale."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Timeout per language (seconds)"
msgstr "Timeout per lingua (secondi)"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Module version: <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">{1}</a>"
msgstr "Versione del modulo: <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">{1}</a>"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Module version: {0}"
msgstr "Versione del modulo: {0}"

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "Supertext does not support this language pair ({0} → {1}). Check the language mapping under Settings → Supertext."
msgstr "Supertext non supporta questa coppia di lingue ({0} → {1}). Verifichi l’associazione delle lingue in Impostazioni → Supertext."

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "The language {0} has no Supertext language yet. Ask your administrator to map it under Settings → Supertext → Language mapping."
msgstr "La lingua {0} non è ancora associata a una lingua Supertext. Chieda al Suo amministratore di associarla in Impostazioni → Supertext → Associazione delle lingue."

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "Supertext offers no formal or informal tone for this language. Ask your administrator to set the form of address under Settings → Supertext to As in the source."
msgstr "Supertext non offre un tono formale o informale per questa lingua. Chieda al Suo amministratore di impostare la forma di cortesia in Impostazioni → Supertext su «Come nell’originale»."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "API key check"
msgstr "Verifica della chiave API"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Not checked yet. The key is checked when you save these settings."
msgstr "Non ancora verificata. La chiave viene verificata quando salva queste impostazioni."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Language mapping"
msgstr "Associazione delle lingue"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "The Supertext language each culture is translated into (and from). Each culture is pre-selected with its Supertext code (de-CH, es …) or the usual default (de → de-DE, en → en-US, fr → fr-FR, it → it-IT, pt → pt-PT, zh → zh-Hans); pick another one to change it. Cultures without an obvious Supertext language (en-IE, de-LI …) need a choice."
msgstr "La lingua Supertext in cui (e da cui) viene tradotta ogni cultura. Ogni cultura è preselezionata con il suo codice Supertext (de-CH, es …) o con il valore predefinito abituale (de → de-DE, en → en-US, fr → fr-FR, it → it-IT, pt → pt-PT, zh → zh-Hans); ne scelga un'altra per modificarla. Le culture senza una lingua Supertext evidente (en-IE, de-LI …) richiedono una scelta."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Some cultures have no Supertext language yet. Content can't be translated into or from them until you choose one."
msgstr "Alcune lingue del sito non sono ancora associate a una lingua Supertext. I contenuti possono essere tradotti in queste lingue o da queste lingue solo dopo che ne avrà scelta una."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Culture"
msgstr "Lingua"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Supertext language"
msgstr "Lingua Supertext"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "— choose —"
msgstr "— scegliere —"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Not mapped: this culture can't be translated with Supertext yet."
msgstr "Non associata: questa lingua non può ancora essere tradotta con Supertext."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Supertext doesn't offer the code {0}. Choose a language from the list."
msgstr "Supertext non offre il codice {0}. Scelga una lingua dall’elenco."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Supertext offers no formal/informal choice for this language: it is translated in the default tone."
msgstr "Supertext non offre una scelta formale/informale per questa lingua: viene tradotta con il tono predefinito."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Support"
msgstr "Assistenza"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Send version information to Supertext"
msgstr "Inviare le informazioni sulla versione a Supertext"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Sends the site URL and the versions of this plugin, the CMS and the runtime to Supertext when you save these settings and after an update, so Supertext support can see which version you run. No content, no API key and no personal data are sent."
msgstr "Invia a Supertext l'URL del sito e le versioni di questo plugin, del CMS e dell'ambiente di esecuzione quando salva queste impostazioni e dopo un aggiornamento. In questo modo l'assistenza Supertext vede quale versione utilizza. Non vengono trasmessi contenuti, chiavi API né dati personali."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Turned on by SUPERTEXT_VERSION_REPORTS."
msgstr "Attivato da SUPERTEXT_VERSION_REPORTS."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Turned off by SUPERTEXT_VERSION_REPORTS."
msgstr "Disattivato da SUPERTEXT_VERSION_REPORTS."

#: Services/KeyCheckMessages.cs
msgctxt "Supertext.OrchardCore.Translation.Services.KeyCheckMessages"
msgid "API key checked: the connection to Supertext works."
msgstr "Chiave API verificata: la connessione a Supertext funziona."

#: Services/KeyCheckMessages.cs
msgctxt "Supertext.OrchardCore.Translation.Services.KeyCheckMessages"
msgid "Supertext rejected the API key. Check that you copied the whole key, or generate a new one at <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (requires the Admin role). No Supertext account yet? Create one at <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">supertext.com</a>."
msgstr "Supertext ha rifiutato la chiave API. Verifichi di aver copiato l'intera chiave oppure ne generi una nuova su <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (richiede il ruolo Admin). Non ha ancora un account Supertext? Ne crei uno su <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">supertext.com</a>."

#: Services/KeyCheckMessages.cs
msgctxt "Supertext.OrchardCore.Translation.Services.KeyCheckMessages"
msgid "No API key is set yet. No Supertext account yet? Create one at <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">supertext.com</a>. Generate your API key at <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (requires the Admin role)."
msgstr "Non è ancora stata inserita alcuna chiave API. Non ha ancora un account Supertext? Ne crei uno su <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">supertext.com</a>. Generi la Sua chiave API su <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (richiede il ruolo Admin)."

#: Services/KeyCheckMessages.cs
msgctxt "Supertext.OrchardCore.Translation.Services.KeyCheckMessages"
msgid "The API key couldn't be checked because Supertext can't be reached. The settings are saved; check again later."
msgstr "Non è stato possibile verificare la chiave API perché Supertext non è raggiungibile. Le impostazioni sono salvate; riprovi più tardi."

#: Services/KeyCheckMessages.cs
msgctxt "Supertext.OrchardCore.Translation.Services.KeyCheckMessages"
msgid "The API key couldn't be checked: Supertext answered with an error ({0}). The settings are saved; check again later."
msgstr "Non è stato possibile verificare la chiave API: Supertext ha risposto con un errore ({0}). Le impostazioni sono salvate; riprovi più tardi."

#: Services/KeyCheckMessages.cs
msgctxt "Supertext.OrchardCore.Translation.Services.KeyCheckMessages"
msgid "checked {0}"
msgstr "verificata {0}"

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "An HTML file holds one language: choose exactly one."
msgstr "Un file HTML contiene una sola lingua: ne scelga esattamente una."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "Nothing to translate."
msgstr "Niente da tradurre."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "Choose a file to import."
msgstr "Scelga un file da importare."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "You may not translate this content item with Supertext."
msgstr "Non è autorizzato a tradurre questo elemento con Supertext."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "This language already has a translation. Tick “Yes, overwrite the existing translations” and import the file again."
msgstr "Questa lingua ha già una traduzione. Selezioni «Sì, sovrascrivi le traduzioni esistenti» e importi di nuovo il file."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "This file wasn't exported by the Supertext module, or its header was removed."
msgstr "Questo file non è stato esportato dal modulo Supertext oppure la sua intestazione è stata rimossa."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "The file is too large (at most 10 MB)."
msgstr "Il file è troppo grande (al massimo 10 MB)."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "This file isn't a valid XLIFF or HTML translation file."
msgstr "Questo file non è un file di traduzione XLIFF o HTML valido."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "This file belongs to another system ({0})."
msgstr "Questo file appartiene a un altro sistema ({0})."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "The site has no language {0}."
msgstr "Il sito non ha la lingua {0}."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "The content item this file was exported from no longer exists."
msgstr "L’elemento da cui è stato esportato questo file non esiste più."

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Export for translation"
msgstr "Esporta per la traduzione"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Download the texts of this item as a file for a translator or a translation tool, or upload it to Supertext's web app. Import the translated file below."
msgstr "Scarichi i testi di questo elemento come file per un traduttore o uno strumento di traduzione, oppure lo carichi nell’app web di Supertext. Importi poi il file tradotto qui sotto."

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "File format"
msgstr "Formato del file"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "XLIFF 1.2 (for translation tools)"
msgstr "XLIFF 1.2 (per strumenti di traduzione)"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "HTML (one language per file)"
msgstr "HTML (una lingua per file)"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Target languages"
msgstr "Lingue di destinazione"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Download file"
msgstr "Scarica il file"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Import translation"
msgstr "Importa traduzione"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Imported texts are saved as drafts of the localizations, like translations with Supertext. Review and publish them when they're ready."
msgstr "I testi importati vengono salvati come bozze delle localizzazioni, come le traduzioni con Supertext. Li verifichi e li pubblichi quando sono pronti."

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Translated file (XLIFF or HTML)"
msgstr "File tradotto (XLIFF o HTML)"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Also import texts whose source changed since the export"
msgstr "Importa anche i testi il cui testo di partenza è cambiato dopo l’esportazione"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Imported: {0}"
msgstr "Importati: {0}"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Skipped, source changed since the export: {0}"
msgstr "Saltati, testo di partenza modificato dopo l’esportazione: {0}"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Not translated in the file: {0}"
msgstr "Non tradotti nel file: {0}"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Formatting changed, not imported: {0}"
msgstr "Formattazione modificata, non importati: {0}"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Not in the file: {0}"
msgstr "Non presenti nel file: {0}"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Saved as a draft. Open it to review."
msgstr "Salvato come bozza. Lo apra per verificarlo."

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Nothing was imported."
msgstr "Non è stato importato nulla."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Suggested by Supertext."
msgstr "Suggerito da Supertext."

#: Drivers/SupertextSettingsDisplayDriver.cs
msgctxt "Supertext.OrchardCore.Translation.Drivers.SupertextSettingsDisplayDriver"
msgid "Supertext doesn't offer the code {0}. Choose a language from the list."
msgstr "Supertext non offre il codice {0}. Scelga una lingua dall'elenco."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Translation review"
msgstr "Revisione delle traduzioni"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Translation review: translations into the cultures ticked go through Supertext's review service, so reviewers can check and correct them on the website with the Supertext Localization Review extension. Their corrections are used the next time the content item is translated."
msgstr "Revisione delle traduzioni: le traduzioni nelle lingue selezionate passano dal servizio di revisione di Supertext, così i revisori possono controllarle e correggerle direttamente sul sito con l’estensione Supertext Localization Review. Le loro correzioni vengono riprese alla prossima traduzione dell’elemento."
