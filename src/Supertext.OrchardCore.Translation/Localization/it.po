#: AdminMenu.cs
msgctxt "Supertext.OrchardCore.Translation.AdminMenu"
msgid "Configuration"
msgstr "Configurazione"

#: AdminMenu.cs
msgctxt "Supertext.OrchardCore.Translation.AdminMenu"
