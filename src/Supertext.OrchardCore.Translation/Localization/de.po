#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "A key is stored. Leave empty to keep it."
msgstr "Ein Schlüssel ist gespeichert. Leer lassen, um ihn zu behalten."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Paste your Supertext API key"
msgstr "Fügen Sie Ihren Supertext-API-Schlüssel ein"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "It may include the Supertext-Auth-Key prefix. The key is stored encrypted and checked when you save."
msgstr "Er darf das Präfix Supertext-Auth-Key enthalten. Der Schlüssel wird verschlüsselt gespeichert und beim Speichern geprüft."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Formal (e.g. German Sie)"
msgstr "Formell (z. B. Sie)"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Informal (e.g. German du)"
msgstr "Informell (z. B. du)"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "When an editor creates a culture version from the Localizations menu, the copy is translated with Supertext before the editor opens it. Translate with Supertext works either way."
msgstr "Wird über das Menü „Lokalisierungen“ eine Sprachversion erstellt, wird die Kopie mit Supertext übersetzt, bevor sie sich im Editor öffnet. „Mit Supertext übersetzen“ funktioniert in beiden Fällen."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Connection"
msgstr "Verbindung"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "API key"
msgstr "API-Schlüssel"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "The API key comes from the SUPERTEXT_API_KEY environment variable (or the Supertext:ApiKey configuration) and overrides the one stored here."
msgstr "Der API-Schlüssel stammt aus der Umgebungsvariablen SUPERTEXT_API_KEY (oder der Konfiguration Supertext:ApiKey) und hat Vorrang vor dem hier gespeicherten."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "No Supertext account yet? <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">Create one at supertext.com</a>. Generate your API key at <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (requires the Admin role)."
msgstr "Noch kein Supertext-Konto? <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">Erstellen Sie eines auf supertext.com</a>. Generieren Sie Ihren API-Schlüssel auf <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (erfordert die Admin-Rolle)."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Remove the stored API key"
msgstr "Gespeicherten API-Schlüssel entfernen"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "API endpoint"
msgstr "API-Endpunkt"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Leave empty to use {0}."
msgstr "Leer lassen, um {0} zu verwenden."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Set by SUPERTEXT_API_ENDPOINT: {0}"
msgstr "Festgelegt durch SUPERTEXT_API_ENDPOINT: {0}"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Translation"
msgstr "Übersetzung"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Translate new localizations automatically"
msgstr "Neue Lokalisierungen automatisch übersetzen"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Form of address"
msgstr "Anrede"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "As in the source"
msgstr "Wie in der Quelle"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Fields not to translate"
msgstr "Nicht zu übersetzende Felder"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "One per line: Part.Field (e.g. Article.Subtitle), a part (e.g. HtmlBodyPart) or ContentType.Part.Field. Excluded fields keep the source text."
msgstr "Einer pro Zeile: Part.Field (z. B. Article.Subtitle), ein Part (z. B. HtmlBodyPart) oder ContentType.Part.Field. Ausgeschlossene Felder behalten den Text der Quelle."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Timeout per language (seconds)"
msgstr "Zeitlimit pro Sprache (Sekunden)"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Module version: <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">{1}</a>"
msgstr "Modulversion: <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">{1}</a>"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Module version: {0}"
msgstr "Modulversion: {0}"

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "Supertext does not support this language pair ({0} → {1}). Check the language mapping under Settings → Supertext."
msgstr "Supertext unterstützt dieses Sprachpaar nicht ({0} → {1}). Prüfen Sie die Sprachzuordnung unter Einstellungen → Supertext."

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "The language {0} has no Supertext language yet. Ask your administrator to map it under Settings → Supertext → Language mapping."
msgstr "Die Sprache {0} ist noch keiner Supertext-Sprache zugeordnet. Bitten Sie Ihre Administratorin oder Ihren Administrator, sie unter Einstellungen → Supertext → Sprachzuordnung zuzuordnen."

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "Supertext offers no formal or informal tone for this language. Ask your administrator to set the form of address under Settings → Supertext to As in the source."
msgstr "Supertext bietet für diese Sprache keine formelle oder informelle Anrede an. Bitten Sie Ihre Administratorin oder Ihren Administrator, die Anrede unter Einstellungen → Supertext auf «Wie in der Quelle» zu stellen."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "API key check"
msgstr "Prüfung des API-Schlüssels"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Not checked yet. The key is checked when you save these settings."
msgstr "Noch nicht geprüft. Der Schlüssel wird geprüft, wenn Sie diese Einstellungen speichern."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Language mapping"
msgstr "Sprachzuordnung"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "The Supertext language each culture is translated into (and from). Each culture is pre-selected with its Supertext code (de-CH, es …) or the usual default (de → de-DE, en → en-US, fr → fr-FR, it → it-IT, pt → pt-PT, zh → zh-Hans); pick another one to change it. Cultures without an obvious Supertext language (en-IE, de-LI …) need a choice."
msgstr "Die Supertext-Sprache, in die (und aus der) jede Kultur übersetzt wird. Jede Kultur ist mit ihrem Supertext-Code (de-CH, es …) oder der üblichen Vorgabe (de → de-DE, en → en-US, fr → fr-FR, it → it-IT, pt → pt-PT, zh → zh-Hans) vorausgewählt; wählen Sie eine andere Sprache, um das zu ändern. Kulturen ohne eindeutige Supertext-Sprache (en-IE, de-LI …) brauchen eine Auswahl."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Some cultures have no Supertext language yet. Content can't be translated into or from them until you choose one."
msgstr "Einigen Kulturen ist noch keine Supertext-Sprache zugeordnet. Inhalte können erst in diese oder aus diesen Kulturen übersetzt werden, wenn Sie eine Sprache wählen."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Culture"
msgstr "Kultur"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Supertext language"
msgstr "Supertext-Sprache"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "— choose —"
msgstr "— auswählen —"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Not mapped: this culture can't be translated with Supertext yet."
msgstr "Nicht zugeordnet: Diese Kultur kann noch nicht mit Supertext übersetzt werden."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Supertext doesn't offer the code {0}. Choose a language from the list."
msgstr "Supertext bietet den Code {0} nicht an. Wählen Sie eine Sprache aus der Liste."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Supertext offers no formal/informal choice for this language: it is translated in the default tone."
msgstr "Supertext bietet für diese Sprache keine formelle/informelle Anrede an; übersetzt wird in der Standard-Anrede."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Support"
msgstr "Support"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Send version information to Supertext"
msgstr "Versionsinformationen an Supertext senden"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Sends the site URL and the versions of this plugin, the CMS and the runtime to Supertext when you save these settings and after an update, so Supertext support can see which version you run. No content, no API key and no personal data are sent."
msgstr "Sendet die URL der Website sowie die Versionen dieses Plugins, des CMS und der Laufzeitumgebung an Supertext, wenn Sie diese Einstellungen speichern und nach einem Update. So sieht der Supertext-Support, welche Version Sie einsetzen. Es werden keine Inhalte, kein API-Schlüssel und keine Personendaten übertragen."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Turned on by SUPERTEXT_VERSION_REPORTS."
msgstr "Durch SUPERTEXT_VERSION_REPORTS eingeschaltet."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Turned off by SUPERTEXT_VERSION_REPORTS."
msgstr "Durch SUPERTEXT_VERSION_REPORTS ausgeschaltet."

#: Services/KeyCheckMessages.cs
msgctxt "Supertext.OrchardCore.Translation.Services.KeyCheckMessages"
msgid "API key checked: the connection to Supertext works."
msgstr "API-Schlüssel geprüft: Die Verbindung zu Supertext funktioniert."

#: Services/KeyCheckMessages.cs
msgctxt "Supertext.OrchardCore.Translation.Services.KeyCheckMessages"
msgid "Supertext rejected the API key. Check that you copied the whole key, or generate a new one at <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (requires the Admin role). No Supertext account yet? Create one at <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">supertext.com</a>."
msgstr "Supertext hat den API-Schlüssel abgelehnt. Prüfen Sie, ob Sie den ganzen Schlüssel kopiert haben, oder erstellen Sie einen neuen unter <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (erfordert die Rolle Admin). Noch kein Supertext-Konto? Erstellen Sie eines auf <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">supertext.com</a>."

#: Services/KeyCheckMessages.cs
msgctxt "Supertext.OrchardCore.Translation.Services.KeyCheckMessages"
msgid "No API key is set yet. No Supertext account yet? Create one at <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">supertext.com</a>. Generate your API key at <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (requires the Admin role)."
msgstr "Es ist noch kein API-Schlüssel eingetragen. Noch kein Supertext-Konto? Erstellen Sie eines auf <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">supertext.com</a>. Ihren API-Schlüssel erstellen Sie unter <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (erfordert die Rolle Admin)."

#: Services/KeyCheckMessages.cs
msgctxt "Supertext.OrchardCore.Translation.Services.KeyCheckMessages"
msgid "The API key couldn't be checked because Supertext can't be reached. The settings are saved; check again later."
msgstr "Der API-Schlüssel konnte nicht geprüft werden, weil Supertext nicht erreichbar ist. Die Einstellungen sind gespeichert; prüfen Sie ihn später erneut."

#: Services/KeyCheckMessages.cs
msgctxt "Supertext.OrchardCore.Translation.Services.KeyCheckMessages"
msgid "The API key couldn't be checked: Supertext answered with an error ({0}). The settings are saved; check again later."
msgstr "Der API-Schlüssel konnte nicht geprüft werden: Supertext hat mit einem Fehler geantwortet ({0}). Die Einstellungen sind gespeichert; prüfen Sie ihn später erneut."

#: Services/KeyCheckMessages.cs
msgctxt "Supertext.OrchardCore.Translation.Services.KeyCheckMessages"
msgid "checked {0}"
msgstr "geprüft {0}"

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "An HTML file holds one language: choose exactly one."
msgstr "Eine HTML-Datei enthält eine Sprache: Wählen Sie genau eine."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "Nothing to translate."
msgstr "Nichts zu übersetzen."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "Choose a file to import."
msgstr "Wählen Sie eine Datei zum Importieren."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "You may not translate this content item with Supertext."
msgstr "Sie dürfen dieses Element nicht mit Supertext übersetzen."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "This language already has a translation. Tick “Yes, overwrite the existing translations” and import the file again."
msgstr "Diese Sprache hat bereits eine Übersetzung. Kreuzen Sie «Ja, bestehende Übersetzungen überschreiben» an und importieren Sie die Datei erneut."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "This file wasn't exported by the Supertext module, or its header was removed."
msgstr "Diese Datei wurde nicht vom Supertext-Modul exportiert, oder ihr Kopfbereich wurde entfernt."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "The file is too large (at most 10 MB)."
msgstr "Die Datei ist zu groß (höchstens 10 MB)."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "This file isn't a valid XLIFF or HTML translation file."
msgstr "Diese Datei ist keine gültige XLIFF- oder HTML-Übersetzungsdatei."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "This file belongs to another system ({0})."
msgstr "Diese Datei gehört zu einem anderen System ({0})."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "The site has no language {0}."
msgstr "Die Website hat keine Sprache {0}."

#: Controllers/AdminController.cs
msgctxt "Supertext.OrchardCore.Translation.Controllers.AdminController"
msgid "The content item this file was exported from no longer exists."
msgstr "Das Element, aus dem diese Datei exportiert wurde, existiert nicht mehr."

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Export for translation"
msgstr "Für Übersetzung exportieren"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Download the texts of this item as a file for a translator or a translation tool, or upload it to Supertext's web app. Import the translated file below."
msgstr "Laden Sie die Texte dieses Elements als Datei für eine Übersetzerin, einen Übersetzer oder ein Übersetzungstool herunter, oder laden Sie sie in die Web-App von Supertext hoch. Importieren Sie die übersetzte Datei unten."

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "File format"
msgstr "Dateiformat"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "XLIFF 1.2 (for translation tools)"
msgstr "XLIFF 1.2 (für Übersetzungstools)"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "HTML (one language per file)"
msgstr "HTML (eine Sprache pro Datei)"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Target languages"
msgstr "Zielsprachen"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Download file"
msgstr "Datei herunterladen"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Import translation"
msgstr "Übersetzung importieren"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Imported texts are saved as drafts of the localizations, like translations with Supertext. Review and publish them when they're ready."
msgstr "Importierte Texte werden wie Übersetzungen mit Supertext als Entwürfe der Lokalisierungen gespeichert. Prüfen und veröffentlichen Sie sie, wenn sie bereit sind."

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Translated file (XLIFF or HTML)"
msgstr "Übersetzte Datei (XLIFF oder HTML)"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Also import texts whose source changed since the export"
msgstr "Auch Texte importieren, deren Ausgangstext sich seit dem Export geändert hat"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Imported: {0}"
msgstr "Importiert: {0}"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Skipped, source changed since the export: {0}"
msgstr "Übersprungen, Ausgangstext seit dem Export geändert: {0}"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Not translated in the file: {0}"
msgstr "In der Datei nicht übersetzt: {0}"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Formatting changed, not imported: {0}"
msgstr "Formatierung verändert, nicht importiert: {0}"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Not in the file: {0}"
msgstr "Nicht in der Datei: {0}"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Saved as a draft. Open it to review."
msgstr "Als Entwurf gespeichert. Öffnen Sie ihn zur Prüfung."

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Nothing was imported."
msgstr "Es wurde nichts importiert."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Suggested by Supertext."
msgstr "Von Supertext vorgeschlagen."

#: Drivers/SupertextSettingsDisplayDriver.cs
msgctxt "Supertext.OrchardCore.Translation.Drivers.SupertextSettingsDisplayDriver"
msgid "Supertext doesn't offer the code {0}. Choose a language from the list."
msgstr "Supertext bietet den Code {0} nicht an. Wählen Sie eine Sprache aus der Liste."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Translation review"
msgstr "Übersetzungsprüfung"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Translation review: translations into the cultures ticked go through Supertext's review service, so reviewers can check and correct them on the website with the Supertext Localization Review extension. Their corrections are used the next time the content item is translated."
msgstr "Übersetzungsprüfung: Übersetzungen in die angekreuzten Kulturen laufen über den Prüfdienst von Supertext, damit Prüferinnen und Prüfer sie mit der Erweiterung Supertext Localization Review direkt auf der Website kontrollieren und korrigieren können. Ihre Korrekturen werden beim nächsten Übersetzen des Elements übernommen."
