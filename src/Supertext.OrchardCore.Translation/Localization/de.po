msgstr "{0} · Ausgangssprache: {1} ({2})"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "No Supertext API key is configured. An administrator can add it under Settings → Supertext."
msgstr "Es ist kein Supertext-API-Schlüssel konfiguriert. Eine Administratorin oder ein Administrator kann ihn unter Einstellungen → Supertext hinzufügen."

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "This item has an unpublished draft. The draft (the latest saved version) is translated."
msgstr "Dieses Element hat einen unveröffentlichten Entwurf. Übersetzt wird der Entwurf (die zuletzt gespeicherte Version)."

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "The site has only one culture. Add cultures under Settings → Localization → Cultures."
msgstr "Die Website hat nur eine Kultur. Fügen Sie Kulturen unter Einstellungen → Localization → Ländereinstellung hinzu."

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Language"
msgstr "Sprache"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Status"
msgstr "Status"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Not translated yet"
msgstr "Noch nicht übersetzt"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Published"
msgstr "Veröffentlicht"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Draft"
msgstr "Entwurf"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Some of the selected languages already have a translation."
msgstr "Einige der gewählten Sprachen haben bereits eine Übersetzung."

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Translating again replaces their texts with a new translation of the source, including any changes made by hand. Their URL and culture stay as they are; the result is saved as a draft."
msgstr "Eine erneute Übersetzung ersetzt ihre Texte durch eine neue Übersetzung der Quelle, auch von Hand vorgenommene Änderungen. URL und Kultur bleiben unverändert; das Ergebnis wird als Entwurf gespeichert."

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Yes, overwrite the existing translations"
msgstr "Ja, bestehende Übersetzungen überschreiben"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Languages are translated one after the other and saved as drafts. This can take a minute for long pages."
msgstr "Die Sprachen werden nacheinander übersetzt und als Entwürfe gespeichert. Bei langen Seiten kann das eine Minute dauern."

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Translate"
msgstr "Übersetzen"

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
msgid "Back"
msgstr "Zurück"

#: Views/Admin/Translate.cshtml
