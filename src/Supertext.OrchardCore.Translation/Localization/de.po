msgstr "{0}: Die Lokalisierung konnte nicht erstellt werden."

#: Drivers/SupertextSettingsDisplayDriver.cs
msgctxt "Supertext.OrchardCore.Translation.Drivers.SupertextSettingsDisplayDriver"
msgid "The endpoint must be an https URL, e.g. https://api.supertext.com/v1/ (http only for localhost)."
msgstr "Der Endpunkt muss eine https-URL sein, z. B. https://api.supertext.com/v1/ (http nur für localhost)."

#: Drivers/SupertextSettingsDisplayDriver.cs
msgctxt "Supertext.OrchardCore.Translation.Drivers.SupertextSettingsDisplayDriver"
msgid "The timeout must be between 30 and 3600 seconds."
msgstr "Das Zeitlimit muss zwischen 30 und 3600 Sekunden liegen."

#: Drivers/SupertextSettingsDisplayDriver.cs
msgctxt "Supertext.OrchardCore.Translation.Drivers.SupertextSettingsDisplayDriver"
msgid "No Supertext API key is set yet, so content can't be translated. Generate one at <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (requires the Admin role; no account yet? <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">create one</a>)."
msgstr "Es ist noch kein Supertext-API-Schlüssel festgelegt, daher können keine Inhalte übersetzt werden. Generieren Sie einen auf <a href=\"{0}\" target=\"_blank\" rel=\"noopener\">supertext.com → Integrations → API</a> (erfordert die Admin-Rolle; noch kein Konto? <a href=\"{1}\" target=\"_blank\" rel=\"noopener\">Erstellen Sie eines</a>)."

#: Drivers/SupertextSettingsDisplayDriver.cs
msgctxt "Supertext.OrchardCore.Translation.Drivers.SupertextSettingsDisplayDriver"
msgid "Connected to Supertext. The API key works."
msgstr "Mit Supertext verbunden. Der API-Schlüssel funktioniert."

#: Drivers/SupertextSettingsDisplayDriver.cs
msgctxt "Supertext.OrchardCore.Translation.Drivers.SupertextSettingsDisplayDriver"
msgid "The settings were saved, but Supertext could not be reached with them: {0}"
msgstr "Die Einstellungen wurden gespeichert, aber Supertext war damit nicht erreichbar: {0}"

#: Handlers/SupertextLocalizationHandler.cs
msgctxt "Supertext.OrchardCore.Translation.Handlers.SupertextLocalizationHandler"
msgid "Translated into {0} with Supertext. {1} text(s) kept the source wording, please review them."
msgstr "Mit Supertext in {0} übersetzt. Einige Texte ({1}) haben den Wortlaut der Quelle behalten, bitte prüfen Sie diese."

#: Handlers/SupertextLocalizationHandler.cs
msgctxt "Supertext.OrchardCore.Translation.Handlers.SupertextLocalizationHandler"
msgid "Translated into {0} with Supertext. Please review the translation before publishing."
msgstr "Mit Supertext in {0} übersetzt. Bitte prüfen Sie die Übersetzung vor dem Veröffentlichen."

#: Handlers/SupertextLocalizationHandler.cs
msgctxt "Supertext.OrchardCore.Translation.Handlers.SupertextLocalizationHandler"
msgid "The {0} version was created but not translated: {1}"
msgstr "Die Version {0} wurde erstellt, aber nicht übersetzt: {1}"

#: Handlers/SupertextLocalizationHandler.cs
msgctxt "Supertext.OrchardCore.Translation.Handlers.SupertextLocalizationHandler"
msgid "The {0} version was created but not translated because of an unexpected error. Try Translate with Supertext later."
msgstr "Die Version {0} wurde erstellt, wegen eines unerwarteten Fehlers aber nicht übersetzt. Versuchen Sie es später mit „Mit Supertext übersetzen“."

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "Supertext did not return a file id."
msgstr "Supertext hat keine Datei-ID zurückgegeben."

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "Supertext failed to translate the document."
msgstr "Supertext konnte das Dokument nicht übersetzen."

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "Your Supertext translation limit is exceeded."
msgstr "Ihr Supertext-Übersetzungslimit ist überschritten."

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "The Supertext file was deleted before it could be downloaded."
msgstr "Die Supertext-Datei wurde gelöscht, bevor sie heruntergeladen werden konnte."

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "Timed out waiting for the Supertext translation."
msgstr "Zeitüberschreitung beim Warten auf die Supertext-Übersetzung."

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "The translated document was empty."
msgstr "Das übersetzte Dokument war leer."

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "No Supertext API key configured (Settings → Supertext, or SUPERTEXT_API_KEY). No Supertext account yet? Create one at https://www.supertext.com/person/en/account/signin. Generate your API key at https://www.supertext.com/en/integrations/api (supertext.com → Integrations → API, requires the Admin role)."
msgstr "Kein Supertext-API-Schlüssel konfiguriert (Einstellungen → Supertext oder SUPERTEXT_API_KEY). Noch kein Supertext-Konto? Erstellen Sie eines auf https://www.supertext.com/person/en/account/signin. Generieren Sie Ihren API-Schlüssel auf https://www.supertext.com/en/integrations/api (supertext.com → Integrations → API, erfordert die Admin-Rolle)."

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "Could not reach Supertext."
msgstr "Supertext ist nicht erreichbar."

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "Authentication failed. Please check the Supertext API key. No Supertext account yet? Create one at https://www.supertext.com/person/en/account/signin. Generate your API key at https://www.supertext.com/en/integrations/api (supertext.com → Integrations → API, requires the Admin role)."
msgstr "Authentifizierung fehlgeschlagen. Bitte prüfen Sie den Supertext-API-Schlüssel. Noch kein Supertext-Konto? Erstellen Sie eines auf https://www.supertext.com/person/en/account/signin. Generieren Sie Ihren API-Schlüssel auf https://www.supertext.com/en/integrations/api (supertext.com → Integrations → API, erfordert die Admin-Rolle)."

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "The requested Supertext resource was not found."
msgstr "Die angeforderte Supertext-Ressource wurde nicht gefunden."

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "The content is too large for Supertext to translate in one go."
msgstr "Der Inhalt ist zu groß, um von Supertext in einem Durchgang übersetzt zu werden."

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "Too many requests to Supertext. Please try again shortly."
msgstr "Zu viele Anfragen an Supertext. Bitte versuchen Sie es gleich noch einmal."

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "The Supertext service is currently unavailable."
msgstr "Der Supertext-Dienst ist zurzeit nicht verfügbar."

#: Api/SupertextClient.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "Supertext answered with HTTP {0}."
msgstr "Supertext hat mit HTTP {0} geantwortet."

#: Services/ContentTranslator.cs
msgctxt "Supertext.OrchardCore.Translation.Services.SupertextMessages"
msgid "No Supertext API key configured. An administrator can add it under Settings → Supertext."
msgstr "Kein Supertext-API-Schlüssel konfiguriert. Eine Administratorin oder ein Administrator kann ihn unter Einstellungen → Supertext hinzufügen."

#: Views/Admin/Translate.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.Admin.Translate"
