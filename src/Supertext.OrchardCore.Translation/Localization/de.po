msgstr "Anrede"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "As in the source"
msgstr "Wie in der Quelle"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Language codes"
msgstr "Sprachcodes"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "One culture=code per line, if Supertext should get a different language code than the culture's name. Cultures of this site: {0}."
msgstr "Eine Zeile pro Kultur=Code, falls Supertext einen anderen Sprachcode als den Namen der Kultur erhalten soll. Kulturen dieser Website: {0}."

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "Fields not to translate"
msgstr "Nicht zu übersetzende Felder"

#: Views/SupertextSettings.Edit.cshtml
msgctxt "Supertext.OrchardCore.Translation.Views.SupertextSettings.Edit"
msgid "One per line: Part.Field (e.g. Article.Subtitle), a part (e.g. HtmlBodyPart) or ContentType.Part.Field. Excluded fields keep the source text."
msgstr "Einer pro Zeile: Part.Field (z. B. Article.Subtitle), ein Part (z. B. HtmlBodyPart) oder ContentType.Part.Field. Ausgeschlossene Felder behalten den Text der Quelle."

